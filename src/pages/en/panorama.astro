---
import SiteHeader from '../../components/SiteHeader.astro';

const base = import.meta.env.BASE_URL;

const stages = [
  {
    id: 's1',
    name: 'Ingress and protocol',
    short: 'API arrives',
    q: 'How do three API protocols collapse into one? How do literal chat delimiters in user input avoid becoming control tokens?',
    desc: 'A request first passes a compatibility front door that normalizes the protocol: OpenAI Chat Completions, OpenAI Responses, and Anthropic Messages all become one internal Conversation structure, then render per model version and encode into token ids. The key here is not tokenization but **separating plain text from real control tokens** — a delimiter appearing literally in user input must stay ordinary text.',
    cost: 'Milliseconds of CPU, but getting it wrong causes precision incidents on long text',
    posts: [
      { href: base + 'en/blog/fw10-deepinfer', title: 'DeepInfer: deepseek-recipe and three-protocol normalization' },
      { href: base + 'en/blog/fw1-why-inference-engine', title: 'Why an inference engine: three walls of naive serving' },
    ],
  },
  {
    id: 's2',
    name: 'Scheduling and batching',
    short: 'Build batches',
    q: 'How does continuous batching order work? How do you hide CPU queueing inside GPU compute?',
    desc: 'The scheduler decides whether this round is prefill or decode, which sequences advance, which cache blocks to reserve, and records in-flight tokens that are submitted but not yet reclaimed so the next round can schedule ahead. **Async scheduling** overlaps CPU batching and postprocessing with GPU forward passes: while the device computes step N, the CPU has already queued step N+1. That is the so-called zero-overhead batch scheduler.',
    cost: 'Scheduling gaps can eat over 20 percent of throughput at low concurrency',
    posts: [
      { href: base + 'en/blog/fw10-deepinfer', title: 'DeepInfer: zero-overhead batch scheduler and DeferredRelease' },
      { href: base + 'en/blog/fw2-vllm-internals', title: 'vLLM internals: paged KV and Model Runner V2' },
      { href: base + 'en/blog/fw3-sglang-internals', title: 'SGLang internals: RadixAttention and prefix reuse' },
      { href: base + 'en/blog/ag1-agent-knowledge-system', title: 'How agent workloads turn caching into scheduling' },
    ],
  },
  {
    id: 's3',
    name: 'Prefix reuse and caching',
    short: 'Find cache',
    q: 'Has this prefix been computed? Which tier holds it, HBM, DRAM, or SSD?',
    desc: 'A prefix hit skips redundant compute, the most direct saving for long context and multi-turn chat. The hard part is tiering: HBM is fast but small, host DRAM is large but slow, SSD is larger still but glacial. **What each tier holds depends on how long the data lives, not how much capacity is left** — DeepInfer SWA state with a 180-second TTL should never occupy the persistent tier.',
    cost: 'In long-context workloads, hit rate directly sets TTFT',
    posts: [
      { href: base + 'en/blog/sys9-kv-cache-fundamentals-optimization', title: 'KV cache landscape: why it sets throughput, latency, and concurrency at once' },
      { href: base + 'en/blog/sys10-kv-cache-engineering-sglang-vllm-attentionstore', title: 'KV cache engineering: two-tier pools, block management, AttentionStore' },
      { href: base + 'en/blog/sys6-hisparse-hierarchical-kv-cache', title: 'HiSparse: treat HBM as a cache and tear down the capacity wall' },
      { href: base + 'en/blog/sys11-hicache-l2-kunlunxin-tuning', title: 'HiCache L2 tuning on Kunlunxin: TTFT 28.83s to 18.45s' },
      { href: base + 'en/blog/fw10-deepinfer', title: 'DeepInfer: SWA tiering and the L minus 134 hit rule' },
    ],
  },
  {
    id: 's4',
    name: 'Prefill and parallel split',
    short: 'Compute input',
    q: 'Tens of thousands of input tokens: TP or EP? Should P and D live on separate machines?',
    desc: 'Prefill handles tens of thousands of tokens at once and competes on compute. When the model does not fit or cannot keep up, you choose among TP (tensor), PP (pipeline), EP (expert), and SP/CP (sequence/context). **PD disaggregation** splits the phases onto separate instances: add P resources when long inputs spike, add D when concurrent generation grows. Production practice runs P to D near 1 to 1.',
    cost: 'Pick the wrong split and you either OOM or lose all gains to communication',
    posts: [
      { href: base + 'en/blog/sys8-parallel-strategies-pd-disaggregation', title: 'Parallel strategy landscape and PD disaggregation: five knives and how to ratio them' },
      { href: base + 'en/blog/sys2-ring-attention', title: 'Sequence parallelism plus Ring Attention: making 1M plus tokens routine' },
      { href: base + 'en/blog/sys7-dcp-decode-context-parallel', title: 'DCP decode context parallel: sharding KV along the sequence dimension' },
      { href: base + 'en/blog/sys12-mooncake-kvcache-centric-serving', title: 'Mooncake: a KVCache-centric PD disaggregated architecture' },
      { href: base + 'en/blog/fw10-deepinfer', title: 'DeepInfer: small-and-precise prefill versus Wide-EP decode' },
    ],
  },
  {
    id: 's5',
    name: 'Decoding acceleration',
    short: 'Emit tokens',
    q: 'How many tokens per forward pass? Are operator and launch overheads pressed to the floor?',
    desc: 'Decode emits one token per step, spending all its time reading weights and caches. Three acceleration routes: **speculative decoding** (draft several at once, verify in parallel, keep however many pass), **graph mode** (CUDA Graph removes kernel launch overhead), and **low-latency kernels** (persistent kernels plus dependent launch, minimizing launches and cross-GPU syncs).',
    cost: 'The biggest optimization surface in the chain, and the easiest to get wrong',
    posts: [
      { href: base + 'en/blog/ep1-speculative-decoding', title: 'Speculative decoding: lossless multi-token generation' },
      { href: base + 'en/blog/ep4-dspark', title: 'DSpark: semi-autoregressive drafting, Markov head, confidence scheduling' },
      { href: base + 'en/blog/ep5-dflash-vs-dspark', title: 'DFlash versus DSpark head to head' },
      { href: base + 'en/blog/ep7-mtp-dspark', title: 'MTP heads and confidence heads: three self-drafting routes chained' },
      { href: base + 'en/blog/fw7-cuda-graph', title: 'Graph mode: CUDA Graph principles and both framework implementations' },
      { href: base + 'en/blog/fw10-deepinfer', title: 'DeepInfer: DSpark variable verification, generating 5 is not verifying 5' },
    ],
  },
  {
    id: 's6',
    name: 'Sampling and constraints',
    short: 'Pick tokens',
    q: 'How are logits sampled? How do you force valid JSON output?',
    desc: 'After the forward pass produces representations, the sampling layer applies generation rules to pick outputs. Two hard engineering needs remain: **structured output** (Regex, JSON Schema, EBNF constrained during decoding rather than parsed afterward) and **reproducibility** (batch-invariant makes a single request independent of batch mates, deterministic sampling makes identical inputs produce identical outputs, which reconciliation, audit, and regression testing all rely on).',
    cost: 'Constrained decoding during decode is nearly free; doing it post hoc is slow and needs fallbacks',
    posts: [
      { href: base + 'en/blog/fw3-sglang-internals', title: 'SGLang internals: the compressed state machine behind structured output' },
      { href: base + 'en/blog/fw10-deepinfer', title: 'DeepInfer: batch-invariant and deterministic sampling (NVIDIA only)' },
      { href: base + 'en/blog/op2-model-quantization', title: 'Model quantization: how low precision shifts the output distribution' },
    ],
  },
  {
    id: 's7',
    name: 'Return and streaming',
    short: 'Send it back',
    q: 'How fast does the first token arrive? How does streaming reassemble into the target protocol?',
    desc: 'TTFT is set by prefill and cache hits; TPOT by per-step decode time. Output must be streamed and parsed back into the caller protocol, including reasoning content, tool calls, JSON objects, and stop sequences. **The easiest thing to miss here is resource lifetime**: request finished and device no longer using its storage are not the same moment, especially under async scheduling.',
    cost: 'TTFT is the only metric users perceive; the rest are internal numbers',
    posts: [
      { href: base + 'en/blog/fw10-deepinfer', title: 'DeepInfer: DeferredRelease and streaming protocol parsing' },
      { href: base + 'en/blog/fw1-why-inference-engine', title: 'Core metrics: TTFT, TPOT, throughput, concurrency' },
      { href: base + 'en/blog/sys12-mooncake-kvcache-centric-serving', title: 'Mooncake: request sequencing under Conductor global scheduling' },
    ],
  },
];

const layers = [
  {
    name: 'L5 - Application and protocol',
    role: 'Who calls, and in what format',
    items: 'API compatibility - protocol normalization - agent orchestration - multi-turn context',
    posts: ['fw10-deepinfer', 'ag1-agent-knowledge-system', 'fw1-why-inference-engine'],
    color: '#7c3aed',
  },
  {
    name: 'L4 - Scheduling and serving',
    role: 'Turn concurrent requests into a sustained pipeline',
    items: 'Batch scheduling - async overlap - prefix-affinity routing - PD coordination - replica LB',
    posts: ['fw1-why-inference-engine', 'fw2-vllm-internals', 'fw3-sglang-internals', 'sys12-mooncake-kvcache-centric-serving'],
    color: '#2563eb',
  },
  {
    name: 'L3 - Decoding algorithms',
    role: 'Advance as many tokens per forward as possible',
    items: 'Speculative decoding - DFlash / DSpark - MTP - confidence scheduling - graph mode',
    posts: ['ep1-speculative-decoding', 'ep4-dspark', 'ep7-mtp-dspark', 'fw7-cuda-graph'],
    color: '#10b981',
  },
  {
    name: 'L2 - Model execution',
    role: 'How weights are organized and attention computed',
    items: 'Frontier architecture - sparse/compressed attention - MoE routing - quantization',
    posts: ['fa1-overview', 'fa4-deepseek-v4', 'fa10-minimax-m31-flash', 'op1-mla-operator'],
    color: '#f59e0b',
  },
  {
    name: 'L1 - Memory and cache',
    role: 'Where KV lives, how long, and how it moves',
    items: 'Paged block management - tiered KV - prefix cache - cross-machine KV pools',
    posts: ['sys9-kv-cache-fundamentals-optimization', 'sys10-kv-cache-engineering-sglang-vllm-attentionstore', 'sys6-hisparse-hierarchical-kv-cache', 'sys12-mooncake-kvcache-centric-serving'],
    color: '#0ea5e9',
  },
  {
    name: 'L0 - Parallelism and operators',
    role: 'How to split across GPUs and compute fast on one',
    items: 'TP / PP / EP / SP / CP - EPLB - FlashMLA - DeepGEMM - TileLang',
    posts: ['sys8-parallel-strategies-pd-disaggregation', 'sys2-ring-attention', 'op1-mla-operator', 'op3-eagleqbsa'],
    color: '#6b7280',
  },
];

const paths = [
  {
    name: 'I want the principles',
    desc: 'Start from why naive serving fails, then dig down through the systems layers, and backfill frontier architecture when model structure comes up.',
    order: ['fw1', 'fw2', 'fw3', 'sys9', 'sys10', 'sys8', 'ep1', 'ep4', 'fw10'],
  },
  {
    name: 'I need to tune a live service',
    desc: 'Metric-first: find who owns TTFT (cache plus prefill), then who owns TPOT (decode plus graph mode), then check the memory wall.',
    order: ['sys9', 'sys11', 'fw7', 'sys8', 'ep4', 'fw10'],
  },
  {
    name: 'I am choosing a stack or forming a judgement',
    desc: 'Cross-comparison view: what boundary each of vLLM, SGLang, and DeepInfer actually delivers, and what you must supply yourself.',
    order: ['fw4', 'fw6', 'fw10', 'sys12', 'tr1'],
  },
  {
    name: 'I care about domestic accelerators',
    desc: 'Kunlunxin and Ascend measurements and tuning: which optimizations port, which platform features are missing.',
    order: ['sys1', 'sys11', 'fw8', 'op3', 'fw10'],
  },
];

const slug = (s: string) => base + 'en/blog/' + s;
---

<!doctype html>
<html lang="en" style={`--bg-url:url('${base}24solar-bg.png')`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
    <title>End-to-End Inference Panorama · One Request From Ingress to First Token</title>
    <meta name="description" content="LLM inference broken into seven request stages and six stack layers, with every layer linked back to the matching post on this site: the map for the whole blog." />
    <style is:global>
      body::before {
        content: "";
        position: fixed;
        inset: 0;
        background-image: var(--bg-url);
        background-size: cover;
        background-position: center top;
        background-repeat: no-repeat;
        opacity: 0.13;
        z-index: -1;
        pointer-events: none;
        transition: opacity .25s ease;
      }
      :root[data-theme="dark"] body::before { opacity: 0.08; }
    </style>
    <style>
      :root {
        --bg: #ffffff; --fg: #1a1a1a; --muted: #6b7280; --accent: #2563eb;
        --border: #e5e7eb; --code-bg: #f6f8fa; --card: #ffffff; --soft: #f8fafc;
      }
      :root[data-theme="dark"] {
        --bg: #0d1117; --fg: #e6edf3; --muted: #8b949e; --accent: #58a6ff;
        --border: #30363d; --code-bg: #161b22; --card: #0d1117; --soft: #161b22;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0; color: var(--fg); background: var(--bg); line-height: 1.75;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "PingFang SC", "Microsoft YaHei", sans-serif;
        transition: background-color .25s ease, color .25s ease;
      }
      .site-header {
        display: flex; justify-content: space-between; align-items: center;
        padding: 16px 24px; border-bottom: 1px solid var(--border);
        position: sticky; top: 0; background: rgba(255,255,255,0.9); backdrop-filter: blur(6px); z-index: 50;
      }
      :root[data-theme="dark"] .site-header { background: rgba(13,17,23,0.9); }
      .brand { font-weight: 700; font-size: 18px; color: var(--fg); text-decoration: none; }
      .site-header nav a { margin-left: 18px; color: var(--muted); text-decoration: none; font-size: 15px; }
      .site-header nav a:hover { color: var(--accent); }
      .lang-switch .cur { color: var(--accent); font-weight: 700; }
      .lang-switch .sep { color: var(--border); margin: 0 6px; }
      .theme-toggle {
        margin-left: 10px; width: 34px; height: 34px; border-radius: 50%;
        border: 1px solid var(--border); background: transparent; color: var(--fg);
        cursor: pointer; font-size: 16px; display: inline-flex; align-items: center; justify-content: center;
      }
      main { max-width: 900px; margin: 0 auto; padding: 36px 24px 80px; }
      h1 { font-size: 28px; line-height: 1.3; margin: 8px 0 6px; }
      .lead { color: var(--muted); font-size: 16px; margin: 0 0 8px; }
      h2 { font-size: 21px; margin-top: 46px; border-left: 4px solid var(--accent); padding-left: 10px; }
      .sec-note { color: var(--muted); font-size: 14px; margin: 6px 0 20px; }

      .rail { display: flex; gap: 6px; overflow-x: auto; padding: 4px 0 10px; scrollbar-width: thin; }
      .rail::-webkit-scrollbar { height: 6px; }
      .rail::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }
      .st {
        flex: 1 0 auto; min-width: 110px; text-align: left; cursor: pointer;
        border: 1px solid var(--border); border-radius: 10px; padding: 10px 12px;
        background: var(--card); color: var(--fg); font-family: inherit;
        transition: border-color .15s, transform .15s, background-color .15s;
      }
      .st:hover { border-color: var(--accent); transform: translateY(-2px); }
      .st.on { border-color: var(--accent); background: var(--soft); box-shadow: 0 0 0 1px var(--accent) inset; }
      .st .num { font-size: 11px; color: var(--muted); font-variant-numeric: tabular-nums; }
      .st.on .num { color: var(--accent); font-weight: 700; }
      .st .nm { font-size: 13px; font-weight: 600; margin-top: 2px; }
      .st .sh { font-size: 11px; color: var(--muted); margin-top: 2px; }

      .detail {
        border: 1px solid var(--border); border-radius: 12px; padding: 20px 22px;
        background: var(--soft); margin-top: 6px; min-height: 260px;
      }
      .detail h3 { margin: 0 0 4px; font-size: 18px; }
      .detail .dq {
        font-size: 14px; color: var(--accent); background: var(--card);
        border: 1px dashed var(--border); border-radius: 8px; padding: 8px 12px; margin: 12px 0;
      }
      .detail p.body { font-size: 15px; margin: 12px 0; }
      .detail p.body strong { color: var(--fg); }
      .cost { font-size: 13px; color: var(--muted); margin: 12px 0 16px; }
      .cost b { color: #b45309; font-weight: 600; }
      :root[data-theme="dark"] .cost b { color: #fbbf24; }
      .plist { list-style: none; padding: 0; margin: 0; }
      .plist li { padding: 7px 0; border-bottom: 1px dashed var(--border); font-size: 14px; }
      .plist li:last-child { border-bottom: none; }
      .plist a { color: var(--fg); text-decoration: none; }
      .plist a:hover { color: var(--accent); }
      .plist a::before { content: "-> "; color: var(--accent); }
      .plabel { font-size: 12px; color: var(--muted); letter-spacing: .04em; margin-bottom: 6px; }

      .stack { margin-top: 8px; }
      .lay {
        display: flex; align-items: flex-start; gap: 14px;
        border: 1px solid var(--border); border-left-width: 4px; border-radius: 8px;
        padding: 12px 14px; margin-bottom: 8px; background: var(--card);
        transition: background-color .15s;
      }
      .lay:hover { background: var(--soft); }
      .lay .lname { font-size: 14px; font-weight: 600; min-width: 170px; }
      .lay .lrole { font-size: 12px; color: var(--muted); min-width: 175px; }
      .lay .litems { font-size: 12px; color: var(--muted); flex: 1; min-width: 150px; }
      .lay .llinks { display: flex; flex-wrap: wrap; gap: 6px; justify-content: flex-end; max-width: 260px; }
      .lay .llinks a {
        font-size: 11px; padding: 2px 8px; border-radius: 999px;
        border: 1px solid var(--border); color: var(--muted); text-decoration: none; white-space: nowrap;
        font-variant-numeric: tabular-nums;
      }
      .lay .llinks a:hover { border-color: var(--accent); color: var(--accent); }
      @media (max-width: 820px) {
        .lay { flex-direction: column; gap: 6px; }
        .lay .llinks { justify-content: flex-start; max-width: none; }
        .lay .lrole, .lay .litems, .lay .lname { min-width: 0; }
      }

      .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 8px; }
      @media (max-width: 700px) { .grid2 { grid-template-columns: 1fr; } }
      .path { border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px; background: var(--card); }
      .path h4 { margin: 0 0 6px; font-size: 15px; }
      .path p { margin: 0 0 10px; font-size: 13px; color: var(--muted); }
      .chain { display: flex; flex-wrap: wrap; gap: 4px; font-size: 11px; font-variant-numeric: tabular-nums; }
      .chain a {
        padding: 2px 8px; border-radius: 999px; text-decoration: none;
        border: 1px solid var(--border); color: var(--fg); background: var(--soft);
      }
      .chain a:hover { border-color: var(--accent); color: var(--accent); }
      .chain span.arr { color: var(--border); align-self: center; }

      .note {
        border-left: 4px solid var(--accent); background: var(--soft);
        padding: 12px 16px; border-radius: 0 8px 8px 0; margin: 22px 0; font-size: 14px;
      }
      footer { text-align: center; color: var(--muted); font-size: 13px; padding: 32px 16px; border-top: 1px solid var(--border); }
    </style>
  </head>
  <body>
    <SiteHeader lang="en" altLang="zh" altHref="/panorama/" />
    <main>
      <h1>End-to-End Inference Panorama</h1>
      <p class="lead">One request crosses seven stages and six stack layers between ingress and the first emitted character.<br />This page is the master index for the whole blog: click any link in the chain and find the matching post.</p>

      <div class="note">
        How to read it: <strong>start with the horizontal lifecycle</strong> to see where a request spends its time, then <strong>read the vertical layers</strong> to see who owns each optimization. Understand both views and the positioning of all 100-plus posts becomes obvious.
      </div>

      <h2>1. Seven stages of one request</h2>
      <p class="sec-note">Horizontally: from the API door to the character stream back to the client, every stage has its bottleneck and its posts.</p>

      <div class="rail" id="rail">
        {stages.map((s, i) => (
          <button class="st" data-id={s.id} type="button" aria-label={s.name}>
            <div class="num">0{i + 1}</div>
            <div class="nm">{s.name}</div>
            <div class="sh">{s.short}</div>
          </button>
        ))}
      </div>

      <div class="detail" id="detail">
        <h3 id="d-name"></h3>
        <div class="dq" id="d-q"></div>
        <p class="body" id="d-desc"></p>
        <p class="cost" id="d-cost"></p>
        <div class="plabel">Related posts</div>
        <ul class="plist" id="d-posts"></ul>
      </div>

      <h2>2. Six stack layers</h2>
      <p class="sec-note">Vertically: the same problem gets optimized again at each abstraction level. The coupling between layers is the genuinely hard part.</p>

      <div class="stack">
        {layers.map((l) => (
          <div class="lay" style={`border-left-color:${l.color}`}>
            <div>
              <div class="lname" style={`color:${l.color}`}>{l.name}</div>
            </div>
            <div class="lrole">{l.role}</div>
            <div class="litems">{l.items}</div>
            <div class="llinks">
              {l.posts.map((p) => <a href={slug(p)}>{p.split('-')[0]}</a>)}
            </div>
          </div>
        ))}
      </div>

      <div class="note">
        A recurring pattern: <strong>the lower the layer, the more certain the gain but the lower the ceiling; the higher the layer, the bigger the gain but the more it depends on workload shape.</strong> Swapping a kernel for 5 percent is safe; changing a scheduling policy might triple throughput, or make it slower at low concurrency.
      </div>

      <h2>3. Pick a route by goal</h2>
      <p class="sec-note">Four ready-made tracks, no need to read post one in order.</p>

      <div class="grid2">
        {paths.map((p) => (
          <div class="path">
            <h4>{p.name}</h4>
            <p>{p.desc}</p>
            <div class="chain">
              {p.order.map((s, i) => (
                <>
                  {i > 0 && <span class="arr">›</span>}
                  <a href={slug(s)}>{s}</a>
                </>
              ))}
            </div>
          </div>
        ))}
      </div>

      <h2>4. Three things this panorama makes easy to miss</h2>

      <div class="note">
        <strong>1. A caching problem is really a lifetime problem.</strong> Not how much VRAM you have to spend, but how long the data lives. DeepInfer SWA state lives 180 seconds, so it should not occupy the persistent tier, and recognizing that frees nearly half the persistent cache capacity.
      </div>

      <div class="note">
        <strong>2. The bulk of latency is often not compute.</strong> At low concurrency with long context, non-compute overheads such as kernel launches, cross-GPU sync, and CPU queueing can dominate TTFT. That is why persistent kernels plus dependent launch, and async scheduling, often pay off more directly than squeezing a single kernel.
      </div>

      <div class="note">
        <strong>3. Model side and systems side must be designed together.</strong> The number 128 appears in the window length, cache block size, replay window, and hit rule at once. That is not a coincidence, they were chosen together. Any plan that touches only the systems layer or only the model layer hits a wall on the other side.
      </div>

      <p style="margin-top:36px;"><a href={base + 'en/'} style="color:var(--accent);text-decoration:none;">← Back to all series</a></p>
    </main>
    <footer>© 2026 LLM Tech Notes · End-to-End Inference Panorama</footer>

    <script define:vars={{ stages }}>
      var el = document.getElementById('rail');
      var dName = document.getElementById('d-name');
      var dQ = document.getElementById('d-q');
      var dDesc = document.getElementById('d-desc');
      var dCost = document.getElementById('d-cost');
      var dPosts = document.getElementById('d-posts');

      function md(s) {
        return s.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
      }

      function show(id) {
        var s = stages.find(function (x) { return x.id === id; });
        if (!s) return;
        Array.prototype.forEach.call(el.querySelectorAll('.st'), function (b) {
          b.classList.toggle('on', b.getAttribute('data-id') === id);
        });
        dName.textContent = s.name;
        dQ.textContent = s.q;
        dDesc.innerHTML = md(s.desc);
        dCost.innerHTML = 'Cost: <b>' + s.cost + '</b>';
        dPosts.innerHTML = s.posts.map(function (p) {
          return '<li><a href="' + p.href + '">' + p.title + '</a></li>';
        }).join('');
      }

      el.addEventListener('click', function (e) {
        var b = e.target.closest('.st');
        if (b) show(b.getAttribute('data-id'));
      });

      show(stages[0].id);

      var btn = document.getElementById('theme-toggle');
      if (!btn) {
        btn = document.createElement('button');
        btn.id = 'theme-toggle';
        btn.className = 'theme-toggle';
        btn.type = 'button';
        btn.setAttribute('aria-label', 'Toggle light/dark mode');
        document.querySelector('.site-header nav').appendChild(btn);
      }
      function sync() {
        var t = document.documentElement.getAttribute('data-theme');
        btn.textContent = t === 'dark' ? '☀️' : '🌙';
      }
      btn.addEventListener('click', function () {
        var cur = document.documentElement.getAttribute('data-theme');
        var nx = cur === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', nx);
        try { localStorage.setItem('theme', nx); } catch (err) {}
        sync();
      });
      sync();
    </script>
  </body>
</html>
