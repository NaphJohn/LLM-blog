---
import SiteHeader from '../../components/SiteHeader.astro';

const base = import.meta.env.BASE_URL;
const spec = [
  { href: base + 'en/blog/ep1-speculative-decoding', title: 'Speculative Decoding: Lossless Multi-Token Generation', date: '2026-07-31' },
  { href: base + 'en/blog/ep2-arg-ceiling', title: "The Autoregressive Drafter's Ceiling: Why It Stalls at 2–3×", date: '2026-07-31' },
  { href: base + 'en/blog/ep3-dflash', title: "DFlash Deep Dive: Block-Diffusion Drafting, KV Injection, and a Bubble-Free Pipeline", date: '2026-07-31' },
  { href: base + 'en/blog/ep4-dspark', title: "DSpark Deep Dive: Semi-Autoregressive Drafting with a Confidence Scheduler", date: '2026-07-31' },
  { href: base + 'en/blog/ep5-dflash-vs-dspark', title: 'Head-to-Head: Where DFlash and DSpark Actually Differ', date: '2026-07-31' },
  { href: base + 'en/blog/ep6-eagle3', title: "EAGLE-3 Deep Dive: Drop the Feature Constraint, Let the Drafter Scale", date: '2026-08-04' },
];
const mm = [
  { href: base + 'en/blog/mm1-foundations', title: '(1) Foundations & Alignment — from "Writing" to "Seeing & Acting"', date: '2026-07-31' },
  { href: base + 'en/blog/mm2-vlm-evolution', title: '(2) VLM Evolution — ViT → CLIP → LLaVA', date: '2026-07-31' },
  { href: base + 'en/blog/mm3-generation', title: '(3) Generative Models — Diffusion vs GAN (Stable Diffusion & GAN)', date: '2026-07-31' },
  { href: base + 'en/blog/mm4-vla-world-model', title: '(4) From VLA to World Models — RT-2 → π0.7 → HiF-VLA', date: '2026-07-31' },
  { href: base + 'en/blog/mm5-efficiency-frontier', title: '(5) Efficient Systems & Frontier Inference — Attention / Inference Opt / On-Device / RL', date: '2026-07-31' },
];
const fw = [
  { href: base + 'en/blog/fw1-why-inference-engine', title: '(1) Why an Inference Engine — Three Walls of Naive Serving', date: '2026-08-01' },
  { href: base + 'en/blog/fw2-vllm-internals', title: '(2) vLLM Internals — From Paged KV to Model Runner V2', date: '2026-08-01' },
  { href: base + 'en/blog/fw3-sglang-internals', title: '(3) SGLang Internals — Prefix Reuse & Frontier Throughput', date: '2026-08-01' },
  { href: base + 'en/blog/fw4-frontier-battles', title: '(4) The Shared Frontier — Sync Stalls, Spec Decode, PD, Low-Bit Quant', date: '2026-08-01' },
  { href: base + 'en/blog/fw5-evolution-timeline', title: '(5) The July 2026 Release Waves — vLLM 0.25→0.26 & SGLang 0.5.15→0.5.16', date: '2026-08-01' },
  { href: base + 'en/blog/fw6-model-support-selection', title: '(6) Supported Models & Selection Guide — Who to Pick', date: '2026-08-01' },
  { href: base + 'en/blog/fw7-cuda-graph', title: '(7) Graph Mode — CUDA Graphs in vLLM & SGLang', date: '2026-08-04' },
  { href: base + 'en/blog/fw8-v1-v2-kunlun', title: '(8) Two Layers of V1/V2 in vLLM 0.25.1 & Where vLLM-Kunlun Lands', date: '2026-08-05' },
];
const vla = [
  { href: base + 'en/blog/vla1-basics', title: '(1) From "See" to "Act" — What Is a Vision-Language-Action Model', date: '2026-08-04' },
  { href: base + 'en/blog/vla2-action-generation', title: '(2) The Action Engine — Diffusion Policy, Flow Matching, Low Latency', date: '2026-08-04' },
  { href: base + 'en/blog/vla3-pi-family', title: '(3) The π Family — Physical Intelligence’s VLA Lineage', date: '2026-08-04' },
  { href: base + 'en/blog/vla4-china-players', title: '(4) Domestic Players — Ant Lingbo, Xiaomi, Tencent', date: '2026-08-04' },
  { href: base + 'en/blog/vla5-world-model', title: '(5) World Models and Deployment — VLA’s Next Stop', date: '2026-08-04' },
  { href: base + 'en/blog/vla6-rt1-discrete-action', title: "(6) RT-1's Discrete-Action Route — TokenLearner, Causal Mask, and Cross-Entropy", date: '2026-08-07' },
];
const fa = [
  { href: base + 'en/blog/fa1-overview', title: '(1) The 2026 Frontier Overview — the Impossible Triangle of Long-Context × Efficiency × Scale', date: '2026-08-06' },
  { href: base + 'en/blog/fa2-kimi-k3', title: '(2) Kimi K3 — Dual Evolution of Attention and MoE', date: '2026-08-06' },
  { href: base + 'en/blog/fa3-minimax-m3', title: '(3) MiniMax M2.7 → M3 — The Leap of Sparse Attention', date: '2026-08-06' },
  { href: base + 'en/blog/fa4-deepseek-v4', title: '(4) DeepSeek V4 — Extreme Compression and Efficient Training', date: '2026-08-06' },
];
const op = [
  { href: base + 'en/blog/op1-mla-operator', title: '(1) MLA Operator-Level — c_kv / W_DKV / W_UK / W_UV Line-by-Line Pseudocode', date: '2026-08-07' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
    <title>大模型技术notes · LLM Tech Notes</title>
    <meta name="description" content="Notes on LLM inference, training and systems optimization. Chinese-first, with key series bilingual." />
  </head>
  <body>
    <SiteHeader lang="en" altLang="zh" altHref="/" />
    <main>
      <h1>大模型技术notes</h1>
      <p class="lead">Notes on LLM tech and multimodality. Chinese-first; six key series (Speculative Decoding Notes, Multimodal Decoding Notes, VLA Decoding Notes, vLLM &amp; SGLang Serving Notes, Frontier Architecture Decoding Notes, Operator Notes) are bilingual. The former "Emotional Intelligence Decoding Notes" (6 posts) have moved to the new site <a href="https://naphjohn.github.io/love-blog/">Heartbeat Decode — EQ &amp; Love Blog</a>.</p>

      <h2>Speculative Decoding Notes</h2>
      <p class="series-tag">Series · 6 episodes, in order: from fundamentals → the autoregressive drafter's ceiling → DFlash / DSpark deep dives → a head-to-head → EAGLE-3 deep dive (why the feature constraint is a scaling lock). Each post has a Chinese counterpart.</p>
      <ul class="post-list">
        {spec.map((p) => (
          <li>
            <a href={p.href}>{p.title}</a>
            <div class="date">{p.date}</div>
          </li>
        ))}
      </ul>

      <h2>Multimodal Decoding Notes</h2>
      <p class="series-tag">Series · 5 episodes, in order: foundations & alignment → VLM evolution → generative models (diffusion / GAN) → VLA & world models → efficient systems & frontier inference. A progressive arc through the common multimodal models, structures, principles, and optimization techniques, each with a Chinese counterpart.</p>
      <ul class="post-list">
        {mm.map((p) => (
          <li>
            <a href={p.href}>{p.title}</a>
            <div class="date">{p.date}</div>
          </li>
        ))}
      </ul>

      <h2>vLLM &amp; SGLang Serving Notes</h2>
      <p class="series-tag">Series · 7 episodes, in order: why an inference engine → vLLM internals → SGLang internals → the shared frontier (sync stalls / spec decode / PD disagg / low-bit quant) → the July 2026 release waves → supported models & selection guide → graph mode (CUDA Graphs). The daily vLLM/SGLang tracking distilled into one arc, with hand-drawn SVG architecture diagrams, each with a Chinese counterpart.</p>
      <ul class="post-list">
        {fw.map((p) => (
          <li>
            <a href={p.href}>{p.title}</a>
            <div class="date">{p.date}</div>
          </li>
        ))}
      </ul>

      <h2>Emotional Intelligence Decoding Notes · Moved</h2>
      <p class="series-tag">This series (6 posts: self-awareness → attraction → gender differences → nonviolent communication → winning favor → long-term management) has moved to the new site <a href="https://naphjohn.github.io/love-blog/">Heartbeat Decode — EQ &amp; Love Blog</a>, with Chinese/English counterparts; the first 3 are free, the last 3 are a "buy the author a coffee" soft-paywall.</p>

      <h2>VLA Decoding Notes</h2>
      <p class="series-tag">Series · 6 episodes, in order: from "see" to "act" (what VLA is) → the action engine (Diffusion Policy / Flow Matching / Action Chunking / low latency) → the π family (π0→π0.7) → domestic players (Ant Lingbo / Xiaomi / Tencent) → world models & deployment (data flywheel / scaling bottleneck / investment view) → RT-1's discrete-action route (TokenLearner / causal mask / cross-entropy). A natural extension of the LLaVA piece in Multimodal Decoding Notes (2) into the robot's "act" capability, each with a Chinese counterpart.</p>
      <ul class="post-list">
        {vla.map((p) => (
          <li>
            <a href={p.href}>{p.title}</a>
            <div class="date">{p.date}</div>
          </li>
        ))}
      </ul>

      <h2>Frontier Architecture Decoding Notes</h2>
      <p class="series-tag">Series · 4 episodes, in order: the 2026 frontier overview (the impossible triangle of long-context × efficiency × scale) → Kimi K3 (redesign attention: KDA + Gated MLA 3:1 + Stable LatentMoE + native vision) → MiniMax M2.7→M3 (sparse attention MSA cuts 1M-context compute to 1/20) → DeepSeek V4 (compress attention CSA+HCA + Muon optimizer + OPD distillation, KV down to ~10%). The three "attention-reshape" controlled experiments strung into one arc: dense → sparse → compressed attention, all converging on MoE + 1M context, each with a Chinese counterpart.</p>
      <ul class="post-list">
        {fa.map((p) => (
          <li>
            <a href={p.href}>{p.title}</a>
            <div class="date">{p.date}</div>
          </li>
        ))}
      </ul>

      <h2>Operator Notes</h2>
      <p class="series-tag">Series · 1 episode (opening). Turn the operators frontier architectures gloss over into line-by-line pseudocode you can implement: episode one is MLA's c_kv / W_DKV / W_UK / W_UV operator and its cache-compression magnitude; later posts cover GQA / MQA, normalization, routing and more. Each post has a Chinese counterpart.</p>
      <ul class="post-list">
        {op.map((p) => (
          <li>
            <a href={p.href}>{p.title}</a>
            <div class="date">{p.date}</div>
          </li>
        ))}
      </ul>

      <section class="engage">
        <p class="engage-tip">Found these notes useful? Buy the author a coffee ☕️</p>
        <div class="reward">
          <div class="reward-col">
            <div class="reward-qr">
              <img src={`${base}reward/alipay.png`} alt="Alipay" loading="lazy" />
            </div>
            <p>Alipay</p>
          </div>
          <div class="reward-col">
            <div class="reward-qr">
              <img src={`${base}reward/wechat.png`} alt="WeChat Pay" loading="lazy" />
            </div>
            <p>WeChat</p>
          </div>
        </div>
      </section>
    </main>
    <footer>© 2026 LLM Tech Notes · Hosted on GitHub Pages</footer>
  </body>
</html>
