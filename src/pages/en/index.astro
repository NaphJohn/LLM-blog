---
import SiteHeader from '../../components/SiteHeader.astro';

const base = import.meta.env.BASE_URL;
const spec = [
  { href: base + 'en/blog/ep1-speculative-decoding', title: 'Speculative Decoding: Lossless Multi-Token Generation', date: '2026-07-31' },
  { href: base + 'en/blog/ep2-arg-ceiling', title: "The Autoregressive Drafter's Ceiling: Why It Stalls at 2–3×", date: '2026-07-31' },
  { href: base + 'en/blog/ep3-dflash', title: "DFlash Deep Dive: Block-Diffusion Drafting, KV Injection, and a Bubble-Free Pipeline", date: '2026-07-31' },
  { href: base + 'en/blog/ep4-dspark', title: "DSpark Deep Dive: Semi-Autoregressive Drafting with a Confidence Scheduler", date: '2026-07-31' },
  { href: base + 'en/blog/ep5-dflash-vs-dspark', title: 'Head-to-Head: Where DFlash and DSpark Actually Differ', date: '2026-07-31' },
];
const mm = [
  { href: base + 'en/blog/mm1-foundations', title: '(1) Foundations & Alignment — from "Writing" to "Seeing & Acting"', date: '2026-07-31' },
  { href: base + 'en/blog/mm2-vlm-evolution', title: '(2) VLM Evolution — ViT → CLIP → LLaVA', date: '2026-07-31' },
  { href: base + 'en/blog/mm3-generation', title: '(3) Generative Models — Diffusion vs GAN (Stable Diffusion & GAN)', date: '2026-07-31' },
  { href: base + 'en/blog/mm4-vla-world-model', title: '(4) From VLA to World Models — RT-2 → π0.7 → HiF-VLA', date: '2026-07-31' },
  { href: base + 'en/blog/mm5-efficiency-frontier', title: '(5) Efficient Systems & Frontier Inference — Attention / Inference Opt / On-Device / RL', date: '2026-07-31' },
];
const eq = [
  { href: base + 'en/blog/eq1-self-awareness', title: '(1) Self-Awareness & Inner Frame — Fix Yourself Before the Relationship', date: '2026-08-01' },
  { href: base + 'en/blog/eq2-attraction', title: '(2) Attraction & First Contact — Attraction Is a Learnable Behavior, Not a Gift', date: '2026-08-01' },
  { href: base + 'en/blog/eq3-gender-differences', title: '(3) Gender Communication Differences — Conflict Is Not Right vs Wrong, but Different Rules', date: '2026-08-01' },
  { href: base + 'en/blog/eq4-nvc-crucial', title: '(4) Nonviolent Communication & Crucial Conversations — Turn Conflict into Consensus', date: '2026-08-01' },
  { href: base + 'en/blog/eq5-win-favor', title: '(5) Winning Favor & Deep Connection — Make the Other "Become Better With You"', date: '2026-08-01' },
  { href: base + 'en/blog/eq6-influence-relationship', title: '(6) Influence & Long-Term Relationship Management — Let Sincerity Be Better Received', date: '2026-08-01' },
];
const fw = [
  { href: base + 'en/blog/fw1-why-inference-engine', title: '(1) Why an Inference Engine — Three Walls of Naive Serving', date: '2026-08-01' },
  { href: base + 'en/blog/fw2-vllm-internals', title: '(2) vLLM Internals — From Paged KV to Model Runner V2', date: '2026-08-01' },
  { href: base + 'en/blog/fw3-sglang-internals', title: '(3) SGLang Internals — Prefix Reuse & Frontier Throughput', date: '2026-08-01' },
  { href: base + 'en/blog/fw4-frontier-battles', title: '(4) The Shared Frontier — Sync Stalls, Spec Decode, PD, Low-Bit Quant', date: '2026-08-01' },
  { href: base + 'en/blog/fw5-evolution-timeline', title: '(5) The July 2026 Release Waves — vLLM 0.25→0.26 & SGLang 0.5.15→0.5.16', date: '2026-08-01' },
  { href: base + 'en/blog/fw6-model-support-selection', title: '(6) Supported Models & Selection Guide — Who to Pick', date: '2026-08-01' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>大模型技术notes · LLM Tech Notes</title>
    <meta name="description" content="Notes on LLM inference, training and systems optimization. Chinese-first, with key series bilingual." />
  </head>
  <body>
    <SiteHeader lang="en" altLang="zh" altHref="/" />
    <main>
      <h1>大模型技术notes</h1>
      <p class="lead">Notes on LLM tech, multimodality, and emotional-intelligence communication. Chinese-first; four key series (Speculative Decoding Notes, Multimodal Decoding Notes, Emotional Intelligence Decoding Notes, vLLM & SGLang Serving Notes) are bilingual.</p>

      <h2>Speculative Decoding Notes</h2>
      <p class="series-tag">Series · 5 episodes, in order: from fundamentals → the autoregressive drafter's ceiling → DFlash / DSpark deep dives → a head-to-head. Each post has a Chinese counterpart.</p>
      <ul class="post-list">
        {spec.map((p) => (
          <li>
            <a href={p.href}>{p.title}</a>
            <div class="date">{p.date}</div>
          </li>
        ))}
      </ul>

      <h2>Multimodal Decoding Notes</h2>
      <p class="series-tag">Series · 5 episodes, in order: foundations & alignment → VLM evolution → generative models (diffusion / GAN) → VLA & world models → efficient systems & frontier inference. A progressive arc through the common multimodal models, structures, principles, and optimization techniques, each with a Chinese counterpart.</p>
      <ul class="post-list">
        {mm.map((p) => (
          <li>
            <a href={p.href}>{p.title}</a>
            <div class="date">{p.date}</div>
          </li>
        ))}
      </ul>

      <h2>Emotional Intelligence Decoding Notes</h2>
      <p class="series-tag">Series · 6 episodes, in order: self-awareness & inner frame → attraction & first contact → gender communication differences → nonviolent communication & crucial conversations → winning favor & deep connection → influence & long-term management. A progressive arc distilling the EQ knowledge from daily emails into one line: stabilize self, be sincerely seen, understand differences, resolve conflict, connect deeply, manage long-term. Each with a Chinese counterpart.</p>
      <ul class="post-list">
        {eq.map((p) => (
          <li>
            <a href={p.href}>{p.title}</a>
            <div class="date">{p.date}</div>
          </li>
        ))}
      </ul>

      <h2>vLLM &amp; SGLang Serving Notes</h2>
      <p class="series-tag">Series · 6 episodes, in order: why an inference engine → vLLM internals → SGLang internals → the shared frontier (sync stalls / spec decode / PD disagg / low-bit quant) → the July 2026 release waves → supported models & selection guide. The daily vLLM/SGLang tracking distilled into one arc, with hand-drawn SVG architecture diagrams, each with a Chinese counterpart.</p>
      <ul class="post-list">
        {fw.map((p) => (
          <li>
            <a href={p.href}>{p.title}</a>
            <div class="date">{p.date}</div>
          </li>
        ))}
      </ul>
    </main>
    <footer>© 2026 LLM Tech Notes · Hosted on GitHub Pages</footer>
  </body>
</html>
