---
import SiteHeader from '../../components/SiteHeader.astro';
import TodayBadge from '../../components/TodayBadge.astro';

const base = import.meta.env.BASE_URL;
const spec = [
  { href: base + 'en/blog/ep1-speculative-decoding', title: 'Speculative Decoding: Lossless Multi-Token Generation', date: '2026-07-31' },
  { href: base + 'en/blog/ep2-arg-ceiling', title: "The Autoregressive Drafter's Ceiling: Why It Stalls at 2–3×", date: '2026-07-31' },
  { href: base + 'en/blog/ep3-dflash', title: "DFlash Deep Dive: Block-Diffusion Drafting, KV Injection, and a Bubble-Free Pipeline", date: '2026-07-31' },
  { href: base + 'en/blog/ep4-dspark', title: "DSpark Deep Dive: Semi-Autoregressive Drafting with a Confidence Scheduler", date: '2026-07-31' },
  { href: base + 'en/blog/ep5-dflash-vs-dspark', title: 'Head-to-Head: Where DFlash and DSpark Actually Differ', date: '2026-07-31' },
  { href: base + 'en/blog/ep6-eagle3', title: "EAGLE-3 Deep Dive: Drop the Feature Constraint, Let the Drafter Scale", date: '2026-08-04' },
  { href: base + 'en/blog/ep7-mtp-dspark', title: 'MTP Heads and Confidence Heads: Linking Three Self-Drafting Routes into One Chain', date: '2026-08-19' },
  { href: base + 'en/blog/ep8-dflash2-and-combining', title: 'DFlash 2 and the Combine Question: Block-Diffusion Upgrade, but Why Not Stack DSpark Scheduling?', date: '2026-09-09' },
];
const mm = [
  { href: base + 'en/blog/mm1-foundations', title: '(1) Foundations & Alignment — from "Writing" to "Seeing & Acting"', date: '2026-07-31' },
  { href: base + 'en/blog/mm2-vlm-evolution', title: '(2) VLM Evolution — ViT → CLIP → LLaVA', date: '2026-07-31' },
  { href: base + 'en/blog/mm3-generation', title: '(3) Generative Models — Diffusion vs GAN (Stable Diffusion & GAN)', date: '2026-07-31' },
  { href: base + 'en/blog/mm4-vla-world-model', title: '(4) From VLA to World Models — RT-2 → π0.7 → HiF-VLA', date: '2026-07-31' },
  { href: base + 'en/blog/mm5-efficiency-frontier', title: '(5) Efficient Systems & Frontier Inference — Attention / Inference Opt / On-Device / RL', date: '2026-07-31' },
];
const fw = [
  { href: base + 'en/blog/fw1-why-inference-engine', title: '(1) Why an Inference Engine — Three Walls of Naive Serving', date: '2026-08-01' },
  { href: base + 'en/blog/fw2-vllm-internals', title: '(2) vLLM Internals — From Paged KV to Model Runner V2', date: '2026-08-01' },
  { href: base + 'en/blog/fw3-sglang-internals', title: '(3) SGLang Internals — Prefix Reuse & Frontier Throughput', date: '2026-08-01' },
  { href: base + 'en/blog/fw4-frontier-battles', title: '(4) The Shared Frontier — Sync Stalls, Spec Decode, PD, Low-Bit Quant', date: '2026-08-01' },
  { href: base + 'en/blog/fw5-evolution-timeline', title: '(5) The July 2026 Release Waves — vLLM 0.25→0.26 & SGLang 0.5.15→0.5.16', date: '2026-08-01' },
  { href: base + 'en/blog/fw6-model-support-selection', title: '(6) Supported Models & Selection Guide — Who to Pick', date: '2026-08-01' },
  { href: base + 'en/blog/fw7-cuda-graph', title: '(7) Graph Mode — CUDA Graphs in vLLM & SGLang', date: '2026-08-04' },
  { href: base + 'en/blog/fw8-v1-v2-kunlun', title: '(8) Two Layers of V1/V2 in vLLM 0.25.1 & Where vLLM-Kunlun Lands', date: '2026-08-05' },
  { href: base + 'en/blog/fw9-wan22-vllm-omni', title: '(9) Wan2.2-I2V/T2V-A14B: Dual-Expert MoE Video Model and vllm-Omni Engine Dissected', date: '2026-08-11' },
  { href: base + 'en/blog/fw10-deepinfer', title: '(10) DeepInfer Dissected: What DeepSeek Handed Over, and What It Kept', date: '2026-10-27' },
];
const vla = [
  { href: base + 'en/blog/vla1-basics', title: '(1) From "See" to "Act" — What Is a Vision-Language-Action Model', date: '2026-08-04' },
  { href: base + 'en/blog/vla2-action-generation', title: '(2) The Action Engine — Diffusion Policy, Flow Matching, Low Latency', date: '2026-08-04' },
  { href: base + 'en/blog/vla3-pi-family', title: '(3) The π Family — Physical Intelligence’s VLA Lineage', date: '2026-08-04' },
  { href: base + 'en/blog/vla4-china-players', title: '(4) Domestic Players — Ant Lingbo, Xiaomi, Tencent', date: '2026-08-04' },
  { href: base + 'en/blog/vla5-world-model', title: '(5) World Models and Deployment — VLA’s Next Stop', date: '2026-08-04' },
  { href: base + 'en/blog/vla6-rt1-discrete-action', title: "(6) RT-1's Discrete-Action Route — TokenLearner, Causal Mask, and Cross-Entropy", date: '2026-08-07' },
  { href: base + 'en/blog/vla7-vjepa2', title: '(7) V-JEPA 2: Self-Supervised Video World Models and Zero-Shot Robot Planning', date: '2026-08-26' },
  { href: base + 'en/blog/vla8-dreamer-v3', title: '(8) Dreamer V3: One Set of Hyperparameters Across 50+ Domains', date: '2026-08-26' },
  { href: base + 'en/blog/vla9-octo', title: '(9) Octo: A 27M Generalist Robot Policy and What Fine-Tunable Really Means', date: '2026-09-11' },
];
const fa = [
  { href: base + 'en/blog/fa1-overview', title: '(1) The 2026 Frontier Overview — the Impossible Triangle of Long-Context × Efficiency × Scale', date: '2026-08-06' },
  { href: base + 'en/blog/fa2-kimi-k3', title: '(2) Kimi K3 — Dual Evolution of Attention and MoE', date: '2026-08-06' },
  { href: base + 'en/blog/fa3-minimax-m3', title: '(3) MiniMax M2.7 → M3 — The Leap of Sparse Attention', date: '2026-08-06' },
  { href: base + 'en/blog/fa4-deepseek-v4', title: '(4) DeepSeek V4 — Extreme Compression and Efficient Training', date: '2026-08-06' },
  { href: base + 'en/blog/fa5-mamba-hybrid-pd-cache', title: '(5) Mamba Hybrid State + PD Disaggregation — Why Cache Correctness Must Avoid Silent Hit Misplacement', date: '2026-08-10' },
  { href: base + 'en/blog/fa6-gated-deltanet', title: '(6) Gated DeltaNet — Conv1D Captures Locality, the Gated Delta Rule Compresses Globality', date: '2026-08-26' },
  { href: base + 'en/blog/fa7-qwen38-arch', title: '(7) Qwen3.8 Dual Checkpoints — Dense 27B vs Sparse Flash-Next (360GB of Weights for 6B Activations)', date: '2026-08-28' },
  { href: base + 'en/blog/fa8-qwen38-three-tiers', title: '(8) The Qwen3.8 Family in One Frame — the 2.4T Flagship, Flash the Serving Build, and Flash-Next the Architecture Preview', date: '2026-09-09' },
  { href: base + 'en/blog/fa9-residual-connections', title: '(9) A Decade of Residual Connections — ResNet → Hyper-Connections → mHC → Attention Residuals', date: '2026-09-20' },
  { href: base + 'en/blog/fa10-minimax-m31-flash', title: '(10) MiniMax M3.1-Flash — All 60 Layers Sparsified, an Efficiency Upgrade That Leaves the Structure Alone', date: '2026-10-23' },
];
const op = [
  { href: base + 'en/blog/op1-mla-operator', title: '(1) MLA Operator-Level — c_kv / W_DKV / W_UK / W_UV Line-by-Line Pseudocode', date: '2026-08-07' },
  { href: base + 'en/blog/op2-model-quantization', title: '(2) Model Quantization for Deployment — the precision-compression spectrum from FP16 to FP4', date: '2026-09-08' },
  { href: base + 'en/blog/op3-eagleqbsa', title: '(3) Ascend EagleQBSA — Quantized × Sparse Joint Attention: the distribution-aware INT8 QK / FP8 PV recipe and Ascend 950 Vector-side tuning (up to 7.6× on attention modules)', date: '2026-10-21' },
];
const pp = [
  { href: base + 'en/blog/pp1-transformer', title: '(1) Transformer Deep Read — Replacing Recurrence with Attention, Making Sequence Modeling Parallel', date: '2026-08-12' },
  { href: base + 'en/blog/pp2-diffusion-policy', title: '(2) Diffusion Policy Deep Read — Porting Stable Diffusion’s Denoising to Robot Action Generation', date: '2026-08-12' },
];
const tr = [
  { href: base + 'en/blog/tr1-vllm-sglang-20260806', title: 'vLLM & SGLang Community Tracker · 2026-08-06 — Both Frameworks Land Ling-3.0-flash Same Day; Step Stalls', date: '2026-08-12' },
  { href: base + 'en/blog/tr2-vllm-sglang-20260807', title: 'vLLM & SGLang Community Tracker · 2026-08-07 — KV Reuse Enters "Combinatorial Correctness" (HiCache / Mooncake)', date: '2026-08-12' },
  { href: base + 'en/blog/tr3-vllm-sglang-20260811', title: 'vLLM & SGLang Community Tracker · 2026-08-11 — vLLM v0.27.0 Ships in One Drop; SGLang Triple-Fixes Unified Pool & Wires PD', date: '2026-08-12' },
];
const sysn = [
  { href: base + 'en/blog/sys1-pcie-numa-nic-hicache', title: '(1) The NUMA x PCIe x NIC Data Path Under P900 + HiCache', date: '2026-08-26' },
  { href: base + 'en/blog/sys2-ring-attention', title: '(2) Sequence Parallelism + Ring Attention: Making 1M+ Token Training Routine', date: '2026-08-26' },
  { href: base + 'en/blog/sys3-attention-evolution', title: '(3) MSA / CSA / HCA: Three Attention Redesign Routes in One Picture', date: '2026-08-26' },
  { href: base + 'en/blog/sys4-knowledge-distillation', title: '(4) Knowledge Distillation: Passing the Dark Knowledge of a Large Model to a Small One', date: '2026-08-26' },
  { href: base + 'en/blog/sys5-attention-evolution-kvcache', title: '(5) From MHA to HiCache: The Full KV Cache Compression Landscape', date: '2026-08-26' },
  { href: base + 'en/blog/sys6-hisparse-hierarchical-kv-cache', title: '(6) HiSparse: Treating HBM as a Cache to Break the Long-Context Capacity Wall', date: '2026-09-07' },
  { href: base + 'en/blog/sys7-dcp-decode-context-parallel', title: '(7) DCP: Decode Context Parallelism — Sharding KV Cache Along the Sequence Dimension', date: '2026-09-08' },
  { href: base + 'en/blog/sys8-parallel-strategies-pd-disaggregation', title: '(8) Parallelism Strategies and PD Disaggregation — slicing TP/PP/EP/SP/CP and sizing the prefill:decode ratio', date: '2026-09-08' },
  { href: base + 'en/blog/sys9-kv-cache-fundamentals-optimization', title: '(9) The KV Cache Landscape — why it decides your throughput, latency and concurrency', date: '2026-09-09' },
  { href: base + 'en/blog/sys10-kv-cache-engineering-sglang-vllm-attentionstore', title: '(10) KV Cache in Production — SGLang two-level pools, vLLM block management, and AttentionStore tiered caching', date: '2026-09-09' },
  { href: base + 'en/blog/sys11-hicache-l2-kunlunxin-tuning', title: '(11) Tuning SGLang HiCache L2 on Kunlunxin P800/P900: Layout, DMA, NUMA and TP-Shared KV', date: '2026-09-15' },
  { href: base + 'en/blog/sys12-mooncake-kvcache-centric-serving', title: '(12) Mooncake — A KVCache-centric PD-Disaggregated Architecture, and Three Ways It Composes with vLLM', date: '2026-10-13' },
];
const agn = [
  { href: base + 'en/blog/ag1-agent-knowledge-system', title: '(1) The Agent Knowledge System — capability stack, context engineering, and inference rebuilt for Agentic workloads', date: '2026-09-08' },
];
const rln = [
  { href: base + 'en/blog/rl1-distributed-rl-training', title: '(1) Distributed RL Training: Running PPO / GRPO From One GPU to a Cluster', date: '2026-09-11' },
];
const hotMods = import.meta.glob('./blog/aihot-*.md', { eager: true }) as Record<string, any>;
const hot = Object.entries(hotMods)
  .map(([key, mod]) => {
    const slug = key.split('/').pop()!.replace('.md', '');
    return {
      href: base + 'en/blog/' + slug,
      title: mod.frontmatter?.title ?? slug,
      date: mod.frontmatter?.pubDate ?? '',
    };
  })
  .sort((a, b) => (b.date || '').localeCompare(a.date || ''));

// Five categories regrouping the twelve series by "what problem are you solving"
const cats = [
  {
    name: 'Models & Decoding Algorithms',
    hint: 'What a model looks like, how one decode step emits several tokens, how operators become runnable code',
    series: [
      { title: 'Frontier Architecture Notes', count: fa.length, anchor: '#s-fa' },
      { title: 'Speculative Decoding Notes', count: spec.length, anchor: '#s-spec' },
      { title: 'Operator Notes', count: op.length, anchor: '#s-op' },
    ],
  },
  {
    name: 'Serving Systems & Engineering',
    hint: 'What the systems layer still owes you after the model computes: where KV lives, how to slice parallelism, how the engine schedules',
    series: [
      { title: 'Inference Systems Infrastructure Notes', count: sysn.length, anchor: '#s-sys' },
      { title: 'vLLM & SGLang Serving Notes', count: fw.length, anchor: '#s-fw' },
    ],
  },
  {
    name: 'Multimodal & Embodied',
    hint: 'From seeing to acting: multimodal models, robot policies, world models, and the papers behind them',
    series: [
      { title: 'VLA Decoding Notes', count: vla.length, anchor: '#s-vla' },
      { title: 'Multimodal Decoding Notes', count: mm.length, anchor: '#s-mm' },
      { title: 'Paper Primer Notes', count: pp.length, anchor: '#s-pp' },
    ],
  },
  {
    name: 'Training & Agents',
    hint: 'The two sides outside inference: the RL training stack, and the workload shape Agents impose',
    series: [
      { title: 'RL Training Notes', count: rln.length, anchor: '#s-rl' },
      { title: 'Agent Notes', count: agn.length, anchor: '#s-ag' },
    ],
  },
  {
    name: 'Timeliness Tracking',
    hint: 'Who shipped what on which day, and who is falling behind',
    series: [
      { title: 'Daily AI Hotspot Notes', count: hot.length, anchor: '#s-aihot' },
      { title: 'Community Tracker Notes', count: tr.length, anchor: '#s-tr' },
    ],
  },
];
const totalAll = cats.reduce((n, c) => n + c.series.reduce((m, s) => m + s.count, 0), 0);
const totalBi = totalAll - hot.length;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
    <title>大模型技术notes · LLM Tech Notes</title>
    <meta name="description" content="Notes on LLM inference, training and systems optimization. Chinese-first, with key series bilingual." />
  <style>
    .series-more { margin: 4px 0 0; font-size: 14px; }
    .series-more a { color: var(--accent); text-decoration: none; }
    .series-more a:hover { text-decoration: underline; }

    /* Category overview */
    .overview { margin: 26px 0 8px; padding: 0; display: grid; gap: 14px; grid-template-columns: 1fr; }
    @media (min-width: 700px) { .overview { grid-template-columns: 1fr 1fr; } }
    .cat {
      border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px 12px;
      background: var(--code-bg); transition: border-color .18s ease, transform .18s ease;
    }
    .cat:hover { border-color: var(--accent); transform: translateY(-2px); }
    .cat h3 { margin: 0 0 4px; font-size: 16px; border: none; padding: 0; display: flex; align-items: baseline; gap: 8px; }
    .cat h3 .num { font-size: 12px; color: var(--muted); font-weight: 400; font-variant-numeric: tabular-nums; }
    .cat p.hint { margin: 0 0 10px; font-size: 13px; color: var(--muted); line-height: 1.6; }
    .cat ul { margin: 0; padding: 0; list-style: none; }
    .cat li { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; padding: 5px 0; border-top: 1px dashed var(--border); font-size: 14px; }
    .cat li:first-child { border-top: none; }
    .cat li a { color: var(--fg); text-decoration: none; }
    .cat li a:hover { color: var(--accent); }
    .cat li .cnt { color: var(--muted); font-size: 12px; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .ov-total { margin: 4px 0 0; font-size: 13px; color: var(--muted); }

    /* Panorama entry */
    .pan-cta {
      display: block; margin: 18px 0 6px; padding: 16px 18px; border-radius: 12px;
      border: 1px solid var(--accent); background: linear-gradient(135deg, rgba(37,99,235,.08), rgba(37,99,235,.02));
      text-decoration: none; color: var(--fg); transition: transform .18s ease, box-shadow .18s ease;
    }
    .pan-cta:hover { transform: translateY(-2px); box-shadow: 0 8px 22px rgba(37,99,235,.14); }
    .pan-cta strong { font-size: 16px; color: var(--accent); }
    .pan-cta span { display: block; margin-top: 6px; font-size: 13px; color: var(--muted); line-height: 1.65; }
    :root[data-theme="dark"] .cat { background: #161b22; }
    :root[data-theme="dark"] .pan-cta { background: linear-gradient(135deg, rgba(88,166,255,.12), rgba(88,166,255,.03)); }

    /* Category divider */
    .cat-head {
      margin-top: 52px; font-size: 15px; letter-spacing: .06em; color: var(--muted);
      border-left: none; border-top: 2px solid var(--border); padding: 14px 0 0; font-weight: 700;
    }
    .cat-note { margin: 6px 0 0; font-size: 13px; color: var(--muted); line-height: 1.7; }
    h2[id^="s-"] { margin-top: 30px; }
    :root { scroll-padding-top: 76px; }
  </style>
  </head>
  <body>
    <SiteHeader lang="en" altLang="zh" altHref="/" />
    <main>
      <h1>大模型技术notes</h1>
      <TodayBadge lang="en" />
      <p class="lead">Notes on LLM tech and multimodality. Chinese-first; twelve series organized into five categories, {totalAll} posts so far, most bilingual.</p>

      <a class="pan-cta" href={base + 'en/panorama/'}>
        <strong>The End-to-End Inference Panorama →</strong>
        <span>Seven stages from request-in to token-out, crossed with six technical layers, mapped onto the posts on this site. Start with the whole picture, then drill down.</span>
      </a>

      <h2>Overview by Category</h2>
      <div class="overview">
        {cats.map((c) => (
          <div class="cat">
            <h3>{c.name}<span class="num">{c.series.reduce((n, s) => n + s.count, 0)} posts</span></h3>
            <p class="hint">{c.hint}</p>
            <ul>
              {c.series.map((s) => (
                <li><a href={s.anchor}>{s.title}</a><span class="cnt">{s.count}</span></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="ov-total">{totalAll} posts total, of which {totalBi} are original long-form pieces with a Chinese counterpart; the daily AI hotspots accumulate by date and are archived separately.</p>

      <h2 class="cat-head" id="c-model">I · Models &amp; Decoding Algorithms</h2>
      <p class="cat-note">What a model looks like (architecture), how one decode step emits several tokens (speculative decoding), how operators become runnable code. This group answers the model-side question: compute correctly, compute fast.</p>

      <h2 id="s-fa">Frontier Architecture Decoding Notes</h2>
      <p class="series-tag">Series · 10 episodes, in order: the 2026 frontier overview (the impossible triangle of long-context × efficiency × scale) → Kimi K3 (redesign attention: KDA + Gated MLA 3:1 + Stable LatentMoE + native vision) → MiniMax M2.7→M3 (sparse attention MSA cuts 1M-context compute to 1/20) → DeepSeek V4 (compress attention CSA+HCA + Muon optimizer + OPD distillation, KV down to ~10%) → Mamba hybrid state + PD disaggregation (how the KV plus SSM recurrent state of Jamba-style hybrids crosses nodes, and why the Mamba state has no token-id key and silently mis-hits) → Gated DeltaNet (Conv1D captures locality, the gated delta rule compresses globality) → Qwen3.8 dual checkpoints (dense 27B vs sparse Flash-Next, 360GB of weights for 6B activations) → the Qwen3.8 family in one frame (2.4T-A95B flagship / Flash serving build / Flash-Next architecture preview, 125B MoE + 51B N-gram at 6B active per token) → a decade of residual connections (equal-weight addition dilutes shallow features and blows up deep hidden states; Hyper-Connections widens the residual stream, mHC buys stability with a doubly stochastic constraint, Attention Residuals treats depth as sequence) → MiniMax M3.1-Flash sparsified end to end (M3 keeps Full Attention in Layer 0-2, Flash swaps it for MSA, so all 60 layers become index-and-select plus block-sparse GQA under long context with no quadratic leftover; the MoE layer count is unchanged while routing is tuned to 129 experts / top-5; plus QAT and a DSpark draft head shipped with the weights). The attention-reshape controlled experiments strung into one arc: dense → sparse → compressed attention → linear attention and hybrid state → sparse MoE at scale → residual-connection restructuring, each with a Chinese counterpart.</p>
      <ul class="post-list">
        {fa.map((p) => (
          <li>
            <a href={p.href}>{p.title}</a>
            <div class="date">{p.date}</div>
          </li>
        ))}
      </ul>

      <h2 id="s-spec">Speculative Decoding Notes</h2>
      <p class="series-tag">Series · 8 episodes, in order: fundamentals → the autoregressive drafter's ceiling → DFlash / DSpark deep dives → a head-to-head → EAGLE-3 (why the feature constraint is a scaling lock) → MTP &amp; confidence heads (three self-draft routes chained) → DFlash 2 upgrade and the meta-question of why frameworks don't just combine them. Each post has a Chinese counterpart.</p>
      <ul class="post-list">
        {spec.map((p) => (
          <li>
            <a href={p.href}>{p.title}</a>
            <div class="date">{p.date}</div>
          </li>
        ))}
      </ul>

      <h2 id="s-op">Operator Notes</h2>
      <p class="series-tag">Series · 3 episodes (ongoing). Turn the operators frontier architectures gloss over into line-by-line pseudocode you can implement: episode one is MLA's c_kv / W_DKV / W_UK / W_UV operator and its cache-compression magnitude; episode two is model quantization for deployment (FP8/INT4/AWQ·GPTQ/FP4 QAT/KV Cache quantization); episode three is Ascend EagleQBSA quantized × sparse joint attention (the distribution-aware recipe of per-block INT8 QK plus per-channel FP8 V/P, Cube-to-Vector transfer with transpose and columnized Softmax reduction, up to 7.6× on attention modules); later posts cover GQA / MQA, normalization, routing and more. Each post has a Chinese counterpart.</p>
      <ul class="post-list">
        {op.map((p) => (
          <li>
            <a href={p.href}>{p.title}</a>
            <div class="date">{p.date}</div>
          </li>
        ))}
      </ul>

      <h2 class="cat-head" id="c-sys">II · Serving Systems &amp; Engineering</h2>
      <p class="cat-note">What the systems layer still owes you after the model computes: where the KV cache lives, how to slice parallelism, how the engine schedules. These two series are two sides of the same coin with the group above — that one reshapes the model, this one reshapes the runtime.</p>

      <h2 id="s-sys">Inference Systems Infrastructure Notes</h2>
      <p class="series-tag">Series · 12 episodes, in order: the NUMA x PCIe x NIC data path under P900 + HiCache → Sequence Parallelism + Ring Attention for 1M+ token training → MSA / CSA / HCA as three attention-redesign routes → knowledge distillation and dark knowledge → the KV cache compression landscape from MHA to HiCache → HiSparse hierarchical KV cache (treating HBM as a cache to break the capacity wall) → DCP decode context parallelism (sharding KV along the sequence dimension, reusing a Scratch Buffer for comms) → parallelism strategies and PD disaggregation (how to slice and combine TP/PP/EP/SP/CP, and how to compute the prefill:decode instance ratio) → the KV Cache landscape (why it can be cached, how big it gets, the three-layer taxonomy and five quantifiable knobs) → KV Cache in production (SGLang two-level pools and HiCache, vLLM paged block management and the cross-layer unified layout, and AttentionStore measured on Kunlunxin P800) → tuning SGLang HiCache L2 on Kunlunxin P800/P900 (tiered architecture and net-benefit formula → layout choice page_first_direct to layer_first and DMA segment count → async transfer, NUMA affinity, transparent huge pages, PCIe IDO ordering → write-policy semantic fix and Ghost List, TP group shared Host KV → end-to-end TTFT from 28.83s to 18.45s) → Mooncake as a KVCache-centric PD-disaggregated architecture (the Conductor only schedules while the split lives in the instance-role layer; four diagrams contrast the vLLM Disagg Proxy + KV Connector design and the non-PD monolith, plus how Mooncake plugs into vLLM as an external KV layer). It answers "once the model has computed, what does the systems layer still owe you," and pairs with the model-side redesign in Frontier Architecture Decoding Notes.</p>
