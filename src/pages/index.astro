---
import SiteHeader from '../components/SiteHeader.astro';

const base = import.meta.env.BASE_URL;
const spec = [
  { href: base + 'blog/ep1-speculative-decoding', title: '推测解码：让大模型“一次生成多个 token”的无损加速', date: '2026-07-31' },
  { href: base + 'blog/ep2-arg-ceiling', title: '自回归草稿模型的天花板：为什么卡在 2–3×', date: '2026-07-31' },
  { href: base + 'blog/ep3-dflash', title: 'DFlash 深度解析：块扩散起草 + KV 注入 + 无空转流水线', date: '2026-07-31' },
  { href: base + 'blog/ep4-dspark', title: 'DSpark 深度解析：半自回归起草 + 马尔可夫头 + 置信度调度', date: '2026-07-31' },
  { href: base + 'blog/ep5-dflash-vs-dspark', title: '同台对比：DFlash 与 DSpark 到底差在哪', date: '2026-07-31' },
];
const aipapers = [
  { href: base + 'blog/ai-2026-07-31', title: 'AI论文+产业热点摘要 · 2026-07-31', date: '2026-07-31' },
  { href: base + 'blog/ai-2026-07-29', title: 'AI论文日报 · 2026-07-29', date: '2026-07-29' },
  { href: base + 'blog/ai-2026-07-25', title: 'AI论文+产业热点摘要 · 2026-07-25', date: '2026-07-25' },
  { href: base + 'blog/ai-2026-07-24', title: 'AI论文+产业热点 · 2026-07-24：MoE成本感知投机解码 / Agent失败溯源 / 端侧4B深研', date: '2026-07-24' },
  { href: base + 'blog/ai-2026-07-23', title: 'AI论文+产业热点摘要 · 2026-07-23', date: '2026-07-23' },
  { href: base + 'blog/ai-2026-07-22', title: 'AI论文+产业热点摘要 · 2026-07-22', date: '2026-07-22' },
  { href: base + 'blog/ai-2026-07-19', title: 'AI论文+产业热点摘要 · 2026-07-19', date: '2026-07-19' },
  { href: base + 'blog/ai-2026-07-18', title: 'AI论文+产业热点摘要 · 2026-07-18', date: '2026-07-18' },
  { href: base + 'blog/ai-2026-07-16', title: '每日AI论文+产业热点 · 2026-07-16（Stable Diffusion 专题）', date: '2026-07-16' },
];
const weekly = [
  { href: base + 'blog/weekly-2026-07-31', title: '技术周报 · 2026-07-24~07-31（全 7 频道聚合）', date: '2026-07-31' },
];
const eng = [
  { href: base + 'blog/eng-operator-notes', title: '算子讲解合集（已讲解算子记录）', date: '2026-07-31' },
  { href: base + 'blog/eng-model-tech-index', title: '模型技术资产索引与知识地图', date: '2026-07-31' },
  { href: base + 'blog/eng-model-tech-overview', title: '模型技术总览 · 结构与原理解读', date: '2026-07-31' },
  { href: base + 'blog/eng-perf-notes', title: '性能优化合集（已讲解话题记录）', date: '2026-07-31' },
  { href: base + 'blog/eng-zhihu-speculative-ssm', title: '大模型推理为什么这么慢？聊聊投机解码与混血模型的落子难题', date: '2026-07-31' },
  { href: base + 'blog/eng-ai-knowledge-base', title: 'AI 知识库 · 大模型技术每日沉淀', date: '2026-07-31' },
  { href: base + 'blog/eng-vllm-sglang-2026-07-16', title: 'vLLM & SGLang 社区跟踪 · 2026-07-16（周四）', date: '2026-07-16' },
  { href: base + 'blog/eng-vllm-sglang-2026-07-14', title: 'vLLM & SGLang 社区跟踪 · 2026-07-14（周二）', date: '2026-07-14' },
  { href: base + 'blog/eng-vllm-sglang-2026-07-13', title: 'vLLM & SGLang 社区跟踪 · 2026-07-13', date: '2026-07-13' },
];
---

<!doctype html>
<html lang="zh">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>大模型技术notes</title>
    <meta name="description" content="大模型推理、训练与系统优化技术笔记，中文为主，关键系列提供中英对照。" />
  </head>
  <body>
    <SiteHeader lang="zh" altLang="en" altHref="/en/" />
    <main>
      <h1>大模型技术notes</h1>
      <p class="lead">记录大模型推理、训练与系统优化的技术笔记。本站以中文为主；关键系列（推测解码手记）提供中英对照。</p>

      <h2>推测解码手记</h2>
      <p class="series-tag">系列 · 共 5 篇，循序渐进：从基础原理 → 自回归草稿的天花板 → DFlash / DSpark 深度解析 → 二者同台对比。每篇附英文对照。</p>
      <ul class="post-list">
        {spec.map((p) => (
          <li><a href={p.href}>{p.title}</a><div class="date">{p.date}</div></li>
        ))}
      </ul>

      <h2>AI论文精读</h2>
      <p class="series-tag">系列 · 共 9 篇，每日 AI 论文 + 产业热点精读（含原文线索）。</p>
      <ul class="post-list">
        {aipapers.map((p) => (
          <li><a href={p.href}>{p.title}</a><div class="date">{p.date}</div></li>
        ))}
      </ul>

      <h2>周报</h2>
      <p class="series-tag">系列 · 七大频道（AI论文 / vLLM&SGLang / 好书 / 情商 / 副业 / 股票早盘 / 股票收盘）周度聚合。</p>
      <ul class="post-list">
        {weekly.map((p) => (
          <li><a href={p.href}>{p.title}</a><div class="date">{p.date}</div></li>
        ))}
      </ul>

      <h2>大模型工程实践</h2>
      <p class="series-tag">系列 · 共 9 篇，从知识库 / 技术总览 / 算子 / 性能优化 / vLLM&SGLang 跟踪到知乎科普，构建由浅入深的大模型工程知识体系。</p>
      <ul class="post-list">
        {eng.map((p) => (
          <li><a href={p.href}>{p.title}</a><div class="date">{p.date}</div></li>
        ))}
      </ul>
    </main>
    <footer>© 2026 大模型技术notes · 托管于 GitHub Pages</footer>
  </body>
</html>
