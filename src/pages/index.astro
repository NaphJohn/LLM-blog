---
import SiteHeader from '../components/SiteHeader.astro';

const base = import.meta.env.BASE_URL;
const spec = [
  { href: base + 'blog/ep1-speculative-decoding', title: '推测解码：让大模型“一次生成多个 token”的无损加速', date: '2026-07-31' },
  { href: base + 'blog/ep2-arg-ceiling', title: '自回归草稿模型的天花板：为什么卡在 2–3×', date: '2026-07-31' },
  { href: base + 'blog/ep3-dflash', title: 'DFlash 深度解析：块扩散起草 + KV 注入 + 无空转流水线', date: '2026-07-31' },
  { href: base + 'blog/ep4-dspark', title: 'DSpark 深度解析：半自回归起草 + 马尔可夫头 + 置信度调度', date: '2026-07-31' },
  { href: base + 'blog/ep5-dflash-vs-dspark', title: '同台对比：DFlash 与 DSpark 到底差在哪', date: '2026-07-31' },
  { href: base + 'blog/ep6-eagle3', title: 'EAGLE-3 深度解析：扔掉 feature 约束，让草稿模型第一次"吃数据"变快', date: '2026-08-04' },
];
const mm = [
  { href: base + 'blog/mm1-foundations', title: '（一）基础与对齐范式：从"会写"到"会看会动"', date: '2026-07-31' },
  { href: base + 'blog/mm2-vlm-evolution', title: '（二）视觉语言模型演进：ViT → CLIP → LLaVA', date: '2026-07-31' },
  { href: base + 'blog/mm3-generation', title: '（三）生成模型：扩散与对抗（Stable Diffusion & GAN）', date: '2026-07-31' },
  { href: base + 'blog/mm4-vla-world-model', title: '（四）从 VLA 到世界模型：RT-2 → π0.7 → HiF-VLA', date: '2026-07-31' },
  { href: base + 'blog/mm5-efficiency-frontier', title: '（五）高效系统与前沿推理：注意力 / 推理优化 / 端侧 / RL', date: '2026-07-31' },
];
const fw = [
  { href: base + 'blog/fw1-why-inference-engine', title: '（一）为什么需要推理引擎：朴素推理的三道墙', date: '2026-08-01' },
  { href: base + 'blog/fw2-vllm-internals', title: '（二）vLLM 原理：从分页 KV 到 Model Runner V2', date: '2026-08-01' },
  { href: base + 'blog/fw3-sglang-internals', title: '（三）SGLang 原理：前缀复用与前沿吞吐优化', date: '2026-08-01' },
  { href: base + 'blog/fw4-frontier-battles', title: '（四）共同前沿：同步停顿、投机解码、PD 分离、低比特量化', date: '2026-08-01' },
  { href: base + 'blog/fw5-evolution-timeline', title: '（五）版本演进时间线：2026 年 7 月的两轮换代', date: '2026-08-01' },
  { href: base + 'blog/fw6-model-support-selection', title: '（六）支持的模型与选型指南：什么场景该选谁', date: '2026-08-01' },
  { href: base + 'blog/fw7-cuda-graph', title: '（七）图模式：CUDA Graph 原理与 vLLM / SGLang 的实现', date: '2026-08-04' },
  { href: base + 'blog/fw8-v1-v2-kunlun', title: '（八）vLLM 0.25.1 的两层 V1/V2 与 vLLM-Kunlun 的落点', date: '2026-08-05' },
  { href: base + 'blog/fw9-wan22-vllm-omni', title: '（九）Wan2.2-I2V/T2V-A14B：双专家 MoE 视频模型与 vllm-omni 引擎剖析', date: '2026-08-11' },
];
const vla = [
  { href: base + 'blog/vla1-basics', title: '（一）从「看懂」到「动手」：什么是视觉-语言-动作模型', date: '2026-08-04' },
  { href: base + 'blog/vla2-action-generation', title: '（二）动作生成的发动机：Diffusion Policy、Flow Matching 与低延迟', date: '2026-08-04' },
  { href: base + 'blog/vla3-pi-family', title: '（三）π 系列演进：Physical Intelligence 的 VLA 路线', date: '2026-08-04' },
  { href: base + 'blog/vla4-china-players', title: '（四）国内重点玩家：蚂蚁灵波、小米、腾讯', date: '2026-08-04' },
  { href: base + 'blog/vla5-world-model', title: '（五）世界模型与落地：VLA 的下一站', date: '2026-08-04' },
  { href: base + 'blog/vla6-rt1-discrete-action', title: '（六）RT-1 的离散动作路线：TokenLearner、因果掩码与交叉熵', date: '2026-08-07' },
];
const fa = [
  { href: base + 'blog/fa1-overview', title: '（一）2026 前沿大模型总览：长上下文 × 效率 × 规模化 的不可能三角', date: '2026-08-06' },
  { href: base + 'blog/fa2-kimi-k3', title: '（二）Kimi K3：注意力与 MoE 的双重进化', date: '2026-08-06' },
  { href: base + 'blog/fa3-minimax-m3', title: '（三）MiniMax M2.7 → M3：稀疏注意力的跨越', date: '2026-08-06' },
  { href: base + 'blog/fa4-deepseek-v4', title: '（四）DeepSeek V4：极致压缩与高效训练', date: '2026-08-06' },
  { href: base + 'blog/fa7-qwen38-arch', title: '（七）Qwen3.8 双 checkpoint 对比：稠密 27B vs 稀疏 Flash-Next（360GB 权重只为换 6B 激活）', date: '2026-08-28' },
];
const op = [
  { href: base + 'blog/op1-mla-operator', title: '（一）MLA 多头潜在注意力的算子级实现：c_kv / W_DKV / W_UK / W_UV 逐行伪代码', date: '2026-08-07' },
];
const pp = [
  { href: base + 'blog/pp1-transformer', title: '（一）Transformer 精读：用「注意力」取代循环，把序列建模变成可并行计算', date: '2026-08-12' },
  { href: base + 'blog/pp2-diffusion-policy', title: '（二）Diffusion Policy 精读：把 Stable Diffusion 的「去噪」范式搬去生成机器人动作', date: '2026-08-12' },
];
const tr = [
  { href: base + 'blog/tr1-vllm-sglang-20260806', title: 'vLLM & SGLang 社区跟踪 · 2026-08-06：双框架同日落地 Ling-3.0-flash，阶跃 Step 适配停滞', date: '2026-08-12' },
  { href: base + 'blog/tr2-vllm-sglang-20260807', title: 'vLLM & SGLang 社区跟踪 · 2026-08-07：KV 缓存复用进入「组合正确性」阶段（HiCache / Mooncake 原理与架构）', date: '2026-08-12' },
  { href: base + 'blog/tr3-vllm-sglang-20260811', title: 'vLLM & SGLang 社区跟踪 · 2026-08-11：vLLM v0.27.0 一次性交付、SGLang 统一内存池三连修与 PD 分离打通', date: '2026-08-12' },
];
---

<!doctype html>
<html lang="zh" style={`--bg-url:url('${base}24solar-bg.png')`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
    <title>大模型技术notes</title>
    <meta name="description" content="大模型推理、训练与系统优化技术笔记，中文为主，关键系列提供中英对照。" />
    <style is:global>
      /* 二十四节气新中式插画全局背景 */
      body::before {
        content: "";
        position: fixed;
        inset: 0;
        background-image: var(--bg-url);
        background-size: cover;
        background-position: center top;
        background-repeat: no-repeat;
        opacity: 0.07;
        z-index: -1;
        pointer-events: none;
      }
    </style>
  </head>
  <body>
    <SiteHeader lang="zh" altLang="en" altHref="/en/" />
    <main>
      <h1>大模型技术notes</h1>
      <p class="lead">记录大模型技术、多模态的实战知识笔记。本站以中文为主；八大系列（推测解码手记、多模态解码手记、VLA 解码手记、vLLM 与 SGLang 框架解码手记、前沿架构解码手记、算子讲解手记、论文科普手记、社区跟踪手记）均提供中英对照。</p>

      <h2>推测解码手记</h2>
      <p class="series-tag">系列 · 共 6 篇，循序渐进：从基础原理 → 自回归草稿的天花板 → DFlash / DSpark 深度解析 → 二者同台对比 → EAGLE-3 深度解析（feature 约束为何是 scaling 枷锁）。每篇附英文对照。</p>
      <ul class="post-list">
        {spec.map((p) => (
          <li><a href={p.href}>{p.title}</a><div class="date">{p.date}</div></li>
        ))}
      </ul>

      <h2>多模态解码手记</h2>
      <p class="series-tag">系列 · 共 5 篇，循序渐进：从基础与对齐范式 → 视觉语言模型（VLM）演进 → 生成模型（扩散/GAN）→ 视觉-语言-动作（VLA）与世界模型 → 高效系统与前沿推理。把多模态常用的模型、结构、原理与优化手段串成一条学习主线，每篇附英文对照。</p>
      <ul class="post-list">
        {mm.map((p) => (
          <li><a href={p.href}>{p.title}</a><div class="date">{p.date}</div></li>
        ))}
      </ul>

      <h2>vLLM 与 SGLang 框架解码手记</h2>
      <p class="series-tag">系列 · 共 9 篇，循序渐进：从为什么需要推理引擎 → vLLM 原理 → SGLang 原理 → 共同前沿（同步停顿/投机解码/PD 分离/低比特量化）→ 2026 年 7 月版本演进 → 支持的模型与选型指南 → 图模式（CUDA Graph）→ vLLM-Kunlun 落点 → Wan2.2 双专家 MoE 与 vllm-omni 引擎剖析。把 vLLM/SGLang 每日跟踪的内容整合进一条主线，并配自绘 SVG 架构图，每篇附英文对照。</p>
      <ul class="post-list">
        {fw.map((p) => (
          <li><a href={p.href}>{p.title}</a><div class="date">{p.date}</div></li>
        ))}
      </ul>

      <h2>VLA 解码手记</h2>
      <p class="series-tag">系列 · 共 6 篇，循序渐进：从"看懂"到"动手"（VLA 是什么）→ 动作生成的发动机（Diffusion Policy / Flow Matching / Action Chunking / 低延迟）→ π 系列演进（π0→π0.7）→ 国内重点玩家（蚂蚁灵波 / 小米 / 腾讯）→ 世界模型与落地（数据飞轮 / scaling 瓶颈 / 投资视角）→ RT-1 离散动作路线（TokenLearner / 因果掩码 / 交叉熵）。把"多模态解码手记（二）的 LLaVA"自然延伸为机器人的"动手"能力，每篇附英文对照。</p>
      <ul class="post-list">
        {vla.map((p) => (
          <li><a href={p.href}>{p.title}</a><div class="date">{p.date}</div></li>
        ))}
      </ul>

      <h2>前沿架构解码手记</h2>
      <p class="series-tag">系列 · 共 5 篇（持续更新），循序渐进：从 2026 前沿大模型总览（长上下文 × 效率 × 规模化的不可能三角）→ Kimi K3（重设计注意力 KDA + Gated MLA 3:1 + Stable LatentMoE + 原生视觉）→ MiniMax M2.7→M3（稀疏注意力 MSA 把 1M 上下文算力压到 1/20）→ DeepSeek V4（压缩注意力 CSA+HCA + Muon 优化器 + OPD 蒸馏，KV 压到 ~10%）→ Qwen3.8 双 checkpoint 对比（稠密 27B vs 稀疏 Flash-Next，360GB 权重只为换 6B 激活）。把"改注意力 / 改权重组织"的对照实验串成一条主线：稠密注意力 → 稀疏注意力 → 压缩注意力 → 稀疏 MoE 大容量，每篇附英文对照。</p>
      <ul class="post-list">
        {fa.map((p) => (
          <li><a href={p.href}>{p.title}</a><div class="date">{p.date}</div></li>
        ))}
      </ul>

      <h2>算子讲解手记</h2>
      <p class="series-tag">系列 · 共 1 篇（开篇）。把前沿架构里常被一笔带过的算子写成可照着实现的逐行伪代码：首篇 MLA 多头潜在注意力的 c_kv / W_DKV / W_UK / W_UV 算子与缓存压缩量级，后续覆盖 GQA / MQA、归一化、路由等算子。每篇附英文对照。</p>
      <ul class="post-list">
        {op.map((p) => (
          <li><a href={p.href}>{p.title}</a><div class="date">{p.date}</div></li>
        ))}
      </ul>

      <h2>论文科普手记</h2>
      <p class="series-tag">系列 · 共 2 篇（开篇）。把大模型时代绕不开的「经典论文」写成可读笔记：从定义注意力的 Transformer（2017）→ 把扩散去噪范式搬进机器人动作生成的 Diffusion Policy（2023）。与「VLA 解码手记」的动作生成发动机、本博客各工程系列互为补充，每篇附英文对照。</p>
      <ul class="post-list">
        {pp.map((p) => (
          <li><a href={p.href}>{p.title}</a><div class="date">{p.date}</div></li>
        ))}
      </ul>

      <h2>社区跟踪手记</h2>
      <p class="series-tag">系列 · 共 1 篇（开篇）。把每日 vLLM / SGLang 上游 commit、模型 cookbook、国产模型适配进度，按「同一天同框 / 谁在掉队」的对照视角做成可读笔记，补足框架解码手记里偏原理、少时效的部分，每篇附英文对照。</p>
      <ul class="post-list">
        {tr.map((p) => (
          <li><a href={p.href}>{p.title}</a><div class="date">{p.date}</div></li>
        ))}
      </ul>

      <section class="engage">
        <p class="engage-tip">觉得这些技术笔记有用？欢迎请作者喝咖啡 ☕️</p>
        <div class="reward">
          <div class="reward-col">
            <div class="reward-qr">
              <img src={`${base}reward/alipay.png`} alt="支付宝收款码" loading="lazy" />
            </div>
            <p>支付宝</p>
          </div>
          <div class="reward-col">
            <div class="reward-qr">
              <img src={`${base}reward/wechat.png`} alt="微信收款码" loading="lazy" />
            </div>
            <p>微信</p>
          </div>
        </div>
      </section>
    </main>
    <footer>© 2026 大模型技术notes · 托管于 GitHub Pages</footer>
  </body>
</html>
