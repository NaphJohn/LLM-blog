---
import SiteHeader from '../../../components/SiteHeader.astro';

const base = import.meta.env.BASE_URL;
const aihotMods = import.meta.glob('../aihot-*.md', { eager: true }) as Record<string, any>;
const aihot = Object.entries(aihotMods)
  .map(([key, mod]) => {
    const slug = key.split('/').pop()!.replace('.md', '');
    return {
      href: base + 'blog/' + slug,
      title: mod.frontmatter?.title ?? slug,
      date: mod.frontmatter?.pubDate ?? '',
    };
  })
  .sort((a, b) => (b.date || '').localeCompare(a.date || ''));
---

<!doctype html>
<html lang="zh" style={`--bg-url:url('${base}24solar-bg.png')`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
    <title>每日AI热点 · 全部 {aihot.length} 期</title>
    <meta name="description" content="每日AI热点全部归档：每天 vLLM / SGLang 上游、国产模型适配、投机解码与推理优化的一线进展，中英对照。" />
    <style is:global>
      body::before {
        content: "";
        position: fixed;
        inset: 0;
        background-image: var(--bg-url);
        background-size: cover;
        background-position: center top;
        background-repeat: no-repeat;
        opacity: 0.07;
        z-index: -1;
        pointer-events: none;
      }
    </style>
  </head>
  <body>
    <SiteHeader lang="zh" altLang="en" altHref="/en/blog/aihot/" />
    <main>
      <h1>每日AI热点 · 全部 {aihot.length} 期</h1>
      <p class="series-tag">系列 · 共 {aihot.length} 篇（持续更新），把每天 vLLM / SGLang 上游、国产模型适配、投机解码与推理优化的一线进展，做成「同一天同框 / 谁在掉队」的时效笔记，补足框架解码手记偏原理、少时效的部分，每篇附英文对照。</p>
      <ul class="post-list">
        {aihot.map((p) => (
          <li><a href={p.href}>{p.title}</a><div class="date">{p.date}</div></li>
        ))}
      </ul>
    </main>
    <footer>© 2026 大模型技术notes · 托管于 GitHub Pages</footer>
  </body>
</html>
