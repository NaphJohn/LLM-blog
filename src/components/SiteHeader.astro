---
const { lang = 'zh', altLang, altHref, series } = Astro.props;
const siteName = '大模型技术notes';
const base = import.meta.env.BASE_URL; // 项目页子路径，如 /LLM-blog/
const homeHref = lang === 'zh' ? base : base + 'en/';
const seriesHref = homeHref;
const altHrefFull = altHref ? base + altHref.replace(/^\//, '') : undefined;
---

<header class="site-header">
  <a href={homeHref} class="brand">{siteName}</a>
  <nav>
    {series && <a href={seriesHref}>{series}</a>}
    {altHrefFull && <a href={altHrefFull} class="lang-switch">{altLang === 'en' ? 'English' : '中文'}</a>}
  </nav>
</header>

<style is:global>
  :root {
    --bg: #ffffff;
    --fg: #1a1a1a;
    --muted: #6b7280;
    --accent: #2563eb;
    --border: #e5e7eb;
    --code-bg: #f6f8fa;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "PingFang SC", "Microsoft YaHei", "Helvetica Neue", Arial, sans-serif;
    color: var(--fg);
    background: var(--bg);
    line-height: 1.75;
  }
  .site-header {
    display: flex; justify-content: space-between; align-items: center;
    padding: 16px 24px; border-bottom: 1px solid var(--border);
    position: sticky; top: 0; background: rgba(255,255,255,0.9); backdrop-filter: blur(6px);
  }
  .brand { font-weight: 700; font-size: 18px; color: var(--fg); text-decoration: none; }
  .site-header nav a { margin-left: 18px; color: var(--muted); text-decoration: none; font-size: 15px; }
  .site-header nav a:hover { color: var(--accent); }
  .lang-switch { font-weight: 600; color: var(--accent) !important; }
  main { max-width: 760px; margin: 0 auto; padding: 36px 24px 64px; }
  .series-tag {
    display: inline-block; font-size: 13px; color: var(--accent);
    background: #eff6ff; padding: 3px 12px; border-radius: 999px; margin-bottom: 12px;
  }
  h1 { font-size: 28px; line-height: 1.3; margin: 8px 0 4px; }
  h2 { font-size: 21px; margin-top: 38px; border-left: 4px solid var(--accent); padding-left: 10px; }
  h3 { font-size: 17px; margin-top: 26px; }
  time { color: var(--muted); font-size: 14px; }
  .lead { color: var(--muted); font-size: 16px; }
  .prose { margin-top: 24px; }
  .prose p { margin: 14px 0; }
  .prose ul, .prose ol { padding-left: 22px; }
  .prose li { margin: 6px 0; }
  .prose code { background: var(--code-bg); padding: 2px 6px; border-radius: 4px; font-size: 0.88em; }
  .prose pre { background: var(--code-bg); padding: 16px; border-radius: 8px; overflow: auto; }
  .prose pre code { background: none; padding: 0; }
  .prose table { width: 100%; border-collapse: collapse; margin: 18px 0; font-size: 14px; }
  .prose th, .prose td { border: 1px solid var(--border); padding: 8px 10px; text-align: left; vertical-align: top; }
  .prose th { background: #f8fafc; }
  .prose blockquote { border-left: 4px solid var(--border); margin: 16px 0; padding: 4px 16px; color: var(--muted); }
  footer { text-align: center; color: var(--muted); font-size: 13px; padding: 32px 16px; border-top: 1px solid var(--border); }
  .post-list { list-style: none; padding: 0; }
  .post-list li { padding: 16px; border: 1px solid var(--border); border-radius: 8px; margin-bottom: 12px; transition: border-color .15s; }
  .post-list li:hover { border-color: var(--accent); }
  .post-list a { font-weight: 600; color: var(--fg); text-decoration: none; font-size: 17px; }
  .post-list .date { color: var(--muted); font-size: 13px; margin-top: 4px; }

  /* 草稿→验证 动画 */
  .sd-anim { border: 1px solid var(--border); border-radius: 10px; padding: 16px; margin: 20px 0; background: #fafafa; }
  .sd-row { display: flex; align-items: center; gap: 10px; margin: 8px 0; }
  .sd-role { font-size: 13px; color: var(--muted); width: 100px; flex: none; }
  .sd-tokens { display: flex; gap: 6px; }
  .sd-tok { display: inline-flex; align-items: center; justify-content: center; min-width: 34px; height: 34px; padding: 0 8px; border-radius: 6px; background: #fff; border: 1px solid var(--border); font-size: 13px; font-variant-numeric: tabular-nums; }
  .sd-drafting { border-color: var(--accent); color: var(--accent); }
  .sd-ok { background: #ecfdf5; border-color: #10b981; color: #047857; }
  .sd-rej { background: #fef2f2; border-color: #ef4444; color: #b91c1c; }
  .sd-status { margin-top: 10px; font-size: 14px; color: var(--fg); min-height: 20px; }
  .sd-btn { margin-top: 10px; padding: 6px 14px; border: 1px solid var(--accent); background: var(--accent); color: #fff; border-radius: 6px; cursor: pointer; font-size: 14px; }

  /* 对比表 高亮 */
  .cmp-table.diff-on tr.diff td { background: #fff7ed; }
  .cmp-btn { margin-top: 12px; padding: 6px 14px; border: 1px solid var(--accent); background: #fff; color: var(--accent); border-radius: 6px; cursor: pointer; font-size: 14px; }
</style>
